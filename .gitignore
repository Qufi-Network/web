# dependencies and build output
node_modules/
.next/
out/
dist/
next-env.d.ts
*.tsbuildinfo
.DS_Store

# verification captures: screenshots produced by tools/*.mjs while
# art-directing the sequence. Regenerable, and large.
.captures/

# flattened copies of this same source. The repository is the source.
QUFI-SOURCE*.md
qufi-network-source.zip

# editor and tooling notes, not part of the website. AGENTS.md is written by
# `next dev`, so it is ignored rather than deleted.
AGENTS.md

# source material, not the website. The decks are what the copy was written
# from; they are kept beside the project rather than in it, because a public
# repository is the wrong place for a pitch and this one already carries the
# instruction that no investor-facing content belongs here.
*.pptx

# the papers themselves. The data room serves them and the site needs them at
# runtime, but this repository is public: anything committed here is available
# from raw.githubusercontent.com with none of the viewer's protection in front
# of it, which would make the whole view-only arrangement decorative. They are
# placed on the host at deploy time instead — see papers/README.md.
papers/*.pdf
